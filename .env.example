# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_API_URL empty to run the web app against the built-in demo
# fleet. Set it to the API gateway to use live data.
NEXT_PUBLIC_API_URL=

# ── API gateway and services ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://carrier:carrier@localhost:5432/haulage
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=haulage-docs
JWT_SECRET=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=sk-placeholder
SENTRY_DSN=
OTEL_ENABLED=false
